# 従業員用LINEボット（@925dqnld）
# LINE Official Account Manager > 設定 > Messaging API の Channel secret
LINE_STAFF_CHANNEL_SECRET=
# LINE Developers > チャネル > Messaging API > チャネルアクセストークン（長期）
LINE_STAFF_CHANNEL_ACCESS_TOKEN=
# ボットを使ってよい従業員のLINEユーザーID（U…、カンマ区切り）
# 未登録の人が話しかけるとIDを返すので、それをここに足す
LINE_STAFF_USER_IDS=

# サイトと同じSupabase（service role。サーバー側だけで使う）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 更新先のサイト
SITE_URL=https://www.jfcreate-mikawaya.com
# サイト側の REVALIDATE_SECRET と同じ値。未設定ならサイトへの反映は最大5分遅れる
SITE_REVALIDATE_SECRET=

# ---- 週次レポート（PostHog → AI提案 → LINE） ----
# Vercel の Cron が付ける合言葉（Vercel が自動で Authorization: Bearer に入れる）。手で試すときにも使う
CRON_SECRET=
# PostHog の読み取り専用 Personal API Key
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=648019
POSTHOG_HOST=https://us.posthog.com
# Claude API（未設定なら数字のまとめだけ送り、提案は作らない）
ANTHROPIC_API_KEY=
# 任意：使うモデル
ANTHROPIC_MODEL=

# ---- 改修（採用→GitHubでAIがPR→プレビュー→LINEで本番反映） ----
# サイトのリポジトリ
GITHUB_REPO=ken5moroho4/kamakura-tofu
# Fine-grained token（kamakura-tofu だけ。Contents: Read and write / Pull requests: Read and write）
GITHUB_TOKEN=
# サイト側の GitHub Actions がプレビュー完了を知らせるときの合言葉（GitHub の Secrets にも同じ値）
GITHUB_NOTIFY_SECRET=
